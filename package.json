{
  "name": "vuttipat-resume",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "assets:sync": "node scripts/sync-assets.mjs",
    "predev": "pnpm assets:sync",
    "dev": "next dev --webpack",
    "prebuild": "pnpm assets:sync",
    "build": "pnpm lint && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:i18n": "node --test scripts/i18n-parity.test.mjs",
    "guards:test": "node --test scripts/no-comments.test.mjs scripts/hardcoded-strings.test.mjs",
    "performance:budget": "node scripts/performance-budget.mjs",
    "e2e:smoke": "playwright test",
    "check": "pnpm test:i18n && pnpm guards:test && pnpm lint && pnpm typecheck && pnpm build && pnpm performance:budget",
    "ci": "pnpm run check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:embed": "storybook build -o public/storybook"
  },
  "dependencies": {
    "@heroui/react": "^3.2.5",
