    "exceljs": "^4.4.0",
    "framer-motion": "^13.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
