    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
